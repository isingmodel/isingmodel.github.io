---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Comments from '../../../components/Comments.astro';
import { defaultLang, formatDate, localePath, ui, type Lang } from '../../../i18n';
import { getPosts, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { lang: post.lang === defaultLang ? undefined : post.lang, slug: post.slug },
    props: {
      post,
      availableLangs: posts.filter((other) => other.slug === post.slug).map((other) => other.lang),
    },
  }));
}

interface Props {
  post: Post;
  availableLangs: Lang[];
}

const { post, availableLangs } = Astro.props;
const { slug, lang, entry } = post;
const { title, description, date } = entry.data;
const { Content } = await render(entry);
---

<Base lang={lang} path={`/posts/${slug}/`} title={title} description={description} availableLangs={availableLangs}>
  <article>
    <header>
      <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
      <h1>{title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <Comments term={slug} lang={lang} />
  <p class="back"><a href={localePath(lang)}>← {ui[lang].allPosts}</a></p>
</Base>

<style>
  header {
    margin: 1rem 0 2.5rem;
  }

  time {
    color: var(--muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }

  h1 {
    margin: 0.25rem 0 0;
    font-size: 2rem;
  }

  .back {
    margin: 3.5rem 0 0;
    font-size: 0.95rem;
  }

  .back a {
    color: var(--muted);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--text);
  }
</style>
