---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Comments from '../../../components/Comments.astro';
import { defaultLang, formatDate, localePath, ui, type Lang } from '../../../i18n';
import { getPosts, type Post } from '../../../lib/posts';
import { getProjects } from '../../../lib/projects';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { lang: post.lang === defaultLang ? undefined : post.lang, slug: post.slug },
    props: {
      post,
      availableLangs: posts.filter((other) => other.slug === post.slug).map((other) => other.lang),
    },
  }));
}

interface Props {
  post: Post;
  availableLangs: Lang[];
}

const { post, availableLangs } = Astro.props;
const { slug, lang, entry } = post;
const { title, description, date } = entry.data;
const { Content } = await render(entry);

// The project this post belongs to, in this language if it has been translated.
const projects = entry.data.project ? (await getProjects()).filter((p) => p.slug === entry.data.project) : [];
if (entry.data.project && projects.length === 0) {
  throw new Error(`Post "${entry.id}" names a project that does not exist: "${entry.data.project}"`);
}
const project = projects.find((p) => p.lang === lang) ?? projects[0];
---

<Base lang={lang} path={`/posts/${slug}/`} title={title} description={description} availableLangs={availableLangs}>
  <article>
    <header>
      <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
      <h1>{title}</h1>
      {
        project && (
          <p class="project">
            {ui[lang].project}:{' '}
            <a href={localePath(project.lang, `/projects/${project.slug}/`)}>{project.entry.data.title}</a>
          </p>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <Comments term={slug} lang={lang} />
  <p class="back-link"><a href={localePath(lang)}>← {ui[lang].allPosts}</a></p>
</Base>

<style>
  header {
    margin: 1rem 0 2.5rem;
  }

  time {
    color: var(--muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }

  h1 {
    margin: 0.25rem 0 0;
    font-size: 2rem;
  }

  .project {
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
