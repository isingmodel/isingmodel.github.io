---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { formatDate, langPaths, localePath, ui, type Lang } from '../../../i18n';
import { getProjects } from '../../../lib/projects';

export const getStaticPaths = langPaths;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const projects = await getProjects(lang);
---

<Base lang={lang} path="/projects/" title={t.projects} description={t.projectsIntro}>
  <h1>{t.projects}</h1>
  <p class="intro">{t.projectsIntro}</p>
  {
    projects.length === 0 ? (
      <p class="empty">{t.noProjects}</p>
    ) : (
      <ul>
        {projects.map(({ slug, entry }) => (
          <li>
            <a href={localePath(lang, `/projects/${slug}/`)}>
              <h2>{entry.data.title}</h2>
              <p>{entry.data.description}</p>
            </a>
            <p class="meta">
              <span>
                <span class="status-mark" data-status={entry.data.status}></span>
                {t[entry.data.status]}
              </span>
              <span>
                {t.updated}{' '}
                <time datetime={entry.data.updated.toISOString()}>{formatDate(entry.data.updated, lang)}</time>
              </span>
            </p>
            {entry.data.cover && <Image class="cover" src={entry.data.cover.src} alt="" width={960} />}
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  h1 {
    margin: 1rem 0 0;
    font-size: 2rem;
  }

  .intro,
  .empty {
    margin: 0.35rem 0 2.5rem;
    color: var(--muted);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
  }

  a {
    color: var(--text);
    text-decoration: none;
  }

  h2 {
    margin: 0;
    font-size: 1.4rem;
  }

  a:hover h2 {
    color: var(--accent);
  }

  a p {
    margin: 0.4rem 0 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0.9rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  /* The cover sits above the text in a single column, and in the margin when there is one. */
  .cover {
    order: -1;
    width: 100%;
    height: auto;
    margin-bottom: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
  }

  @media (min-width: 80rem) {
    li {
      min-height: 12.5rem;
    }

    .cover {
      position: absolute;
      top: 1.75rem;
      left: calc(100% + var(--margin-gap));
      width: var(--margin);
      margin: 0;
      border-radius: 6px;
    }
  }
</style>
