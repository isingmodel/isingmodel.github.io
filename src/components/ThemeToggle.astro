---
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const label = ui[Astro.props.lang].theme;
---

<button class="theme-toggle" type="button" aria-label={label} title={label}>
  <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
  </svg>
  <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
</button>

<script>
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {}
    // Lets the lattice and the comment box follow along.
    document.dispatchEvent(new CustomEvent('themechange'));
  });
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    padding: 0.3rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--text);
  }

  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sun,
  :global([data-theme='dark']) .moon {
    display: none;
  }

  :global([data-theme='dark']) .sun {
    display: block;
  }
</style>
